exports[`Rust control flow > breaks and continues labeled loops 1`] = `
"labeled [rust] /* cf:labeled */
  entry entry "entry" @74:0-74:33
    next -> n0
  n0 statement "let mut total = 0;" @76:4-76:22
    next -> n1
  n1 loop loop "loop 'outer" @77:4-77:17
    loop-body -> n2
  n2 loop for "for item in items" @78:8-78:26
    loop-body -> n3
    loop-exit -> n8
  n3 decision if "if *item < 0" @79:12-79:25
    true -> n4
    false -> n5
  n4 break jump='outer "break 'outer" @80:16-80:28
    loop-exit "break 'outer" -> n9
  n5 decision if "if *item == 0" @82:12-82:26
    true -> n6
    false -> n7
  n6 continue "continue" @83:16-83:24
    back -> n2
  n7 statement "total += item" @85:12-85:25
    back -> n2
  n8 break "break" @87:8-87:13
    loop-exit -> n9
  n9 return "return total" @89:4-89:9
    next -> exit
  exit exit "exit" @90:0-90:1
"
`;


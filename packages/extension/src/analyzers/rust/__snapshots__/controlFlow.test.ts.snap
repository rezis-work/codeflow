exports[`Rust control flow > ends on panic and unreachable, and dims the code after them 1`] = `
"give_up [rust] /* cf:panic */
  entry entry "entry" @111:0-111:30
    next -> n0
  n0 decision if "if flag" @113:4-113:12
    true -> n1
    false -> n2
  n1 throw "panic!(\\"no\\")" @114:8-114:20 calls panic
    exception "panic" -> exit
  n2 throw "unreachable!()" @116:4-116:18 calls unreachable
    exception "panic" -> exit
    next -> n3
  n3 return unreachable "return 0" @117:4-117:5
  exit exit "exit" @118:0-118:1
"
`;


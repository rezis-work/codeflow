exports[`Rust control flow > covers loop, while, while let, and for, with break-with-value 1`] = `
"loops [rust] /* cf:loops */
  entry entry "entry" @51:0-51:31
    next -> n0
  n0 statement "let mut total = 0;" @53:4-53:22
    next -> n1
  n1 statement "let mut guard = Some(1);" @54:4-54:28 calls Some
    next -> n2
  n2 loop loop "loop" @55:4-55:9
    loop-body -> n3
  n3 statement "total += 1" @56:8-56:18
    next -> n4
  n4 decision if "if total > 2" @57:8-57:21
    true -> n5
    back "false" -> n2
  n5 break "break total" @58:12-58:23
    loop-exit "break total" -> n6
  n6 loop while "while total < 4" @61:4-61:20
    loop-body -> n7
    loop-exit -> n8
  n7 statement "total += 1" @62:8-62:18
    back -> n6
  n8 loop while "while let Some(n) = guard" @64:4-64:30
    loop-body -> n9
    loop-exit -> n11
  n9 statement "guard = None" @65:8-65:20
    next -> n10
  n10 statement "total += n" @66:8-66:18
    back -> n8
  n11 loop for "for item in items" @68:4-68:22
    loop-body -> n12
    loop-exit -> n13
  n12 statement "total += item" @69:8-69:21
    back -> n11
  n13 return "return total" @71:4-71:9
    next -> exit
  exit exit "exit" @72:0-72:1
"
`;

exports[`Rust control flow > dims code after return 1`] = `
"dead [rust] /* cf:dead */
  entry entry "entry" @173:0-173:27
    next -> n0
  n0 decision if "if flag" @175:4-175:12
    true -> n1
    false -> n3
  n1 return "return 1" @176:8-176:16
    next -> exit
    next -> n2
  n2 statement unreachable "let _never = 2;" @177:8-177:23
  n3 call "break_later()" @179:4-179:17 calls break_later
    next -> n4
  n4 return "return 3" @180:4-180:5
    next -> exit
  exit exit "exit" @181:0-181:1
"
`;


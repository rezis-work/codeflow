// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Rust control flow > branches if / else-if / else 1`] = `
"branch [rust] /* cf:branch */
  entry entry "entry" @2:0-2:51
    next -> n0
  n0 decision if "if user.is_none()" @4:4-4:22 calls is_none
    true -> n1
    false -> n2
  n1 return "return \\"missing\\"" @5:8-5:24
    next -> exit
  n2 decision if "if admin" @6:11-6:20
    true -> n3
    false -> n4
  n3 return "return \\"admin\\"" @7:8-7:22
    next -> exit
  n4 return "return user.unwrap_or(\\"guest\\")" @9:8-9:38 calls unwrap_or
    next -> exit
  exit exit "exit" @11:0-11:1
"
`;


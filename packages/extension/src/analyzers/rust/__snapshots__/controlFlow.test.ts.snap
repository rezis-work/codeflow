exports[`Rust control flow > gives assert a conditional panic edge 1`] = `
"checked [rust] /* cf:assert */
  entry entry "entry" @128:0-128:26
    next -> n0
  n0 decision if "assert!(n > 0)" @130:4-130:18 calls assert
    false "panic" -> n1
    true -> n2
  n1 throw "panic" @130:4-130:18
    exception "panic" -> exit
  n2 decision if "assert_eq!(n, n)" @131:4-131:20 calls assert_eq
    false "panic" -> n3
    true -> n4
  n3 throw "panic" @131:4-131:20
    exception "panic" -> exit
  n4 decision if "assert_ne!(n, 0)" @132:4-132:20 calls assert_ne
    false "panic" -> n5
    true -> n6
  n5 throw "panic" @132:4-132:20
    exception "panic" -> exit
  n6 return "return n" @133:4-133:5
    next -> exit
  exit exit "exit" @134:0-134:1
"
`;


exports[`Python control flow > fails an assert on the false edge 1`] = `
"checked [python] cf:assert
  entry entry "entry" @82:0-82:0
    next -> n0
  n0 decision if "assert value > 0" @83:4-83:20
    false "fail" -> n1
    true "ok" -> n2
  n1 throw "AssertionError" @83:4-83:20
    exception -> exit
  n2 return "return value" @84:4-84:16
    next -> exit
  exit exit "exit" @84:16-84:16
"
`;

exports[`Python control flow > loops with for/else, break, and continue 1`] = `
"loop_for [python] cf:for
  entry entry "entry" @21:0-21:0
    next -> n0
  n0 statement "total = 0" @22:4-22:13
    next -> n1
  n1 loop for "for item in items" @23:4-24:8
    loop-body -> n2
    loop-exit "else" -> n7
  n2 decision if "if item < 0" @24:8-25:12
    true "yes" -> n3
    false "no" -> n4
  n3 break "break" @25:12-25:17
    next -> n8
  n4 decision if "if item == 0" @26:8-27:12
    true "yes" -> n5
    false "no" -> n6
  n5 continue "continue" @27:12-27:20
    back -> n1
  n6 statement "total += item" @28:8-28:21
    back -> n1
  n7 statement "total += 1" @30:8-30:18
    next -> n8
  n8 return "return total" @31:4-31:16
    next -> exit
  exit exit "exit" @31:16-31:16
"
`;

exports[`Python control flow > loops with while/else 1`] = `
"loop_while [python] cf:while
  entry entry "entry" @34:0-34:0
    next -> n0
  n0 loop while "while n > 0" @35:4-36:8
    loop-body -> n1
    loop-exit "else" -> n6
  n1 statement "n -= 1" @36:8-36:14
    next -> n2
  n2 decision if "if n == 3" @37:8-38:12
    true "yes" -> n3
    false "no" -> n4
  n3 continue "continue" @38:12-38:20
    back -> n0
  n4 decision if "if n == 1" @39:8-40:12
    true "yes" -> n5
    false "no" -> n0
  n5 break "break" @40:12-40:17
    next -> n7
  n6 statement "n = -1" @42:8-42:14
    next -> n7
  n7 return "return n" @43:4-43:12
    next -> exit
  exit exit "exit" @43:12-43:12
"
`;

exports[`Python control flow > matches cases, a guarded wildcard, and a default 1`] = `
"matched [python] cf:match
  entry entry "entry" @9:0-9:0
    next -> n0
  n0 switch "match value" @10:4-10:16
    case "0" -> n1
    case "1 | 2" -> n2
    case "_ if value > 10" -> n3
    default "_" -> n4
  n1 return "return \\"zero\\"" @12:12-12:25
    next -> exit
  n2 return "return \\"small\\"" @14:12-14:26
    next -> exit
  n3 return "return \\"big\\"" @16:12-16:24
    next -> exit
  n4 return "return \\"other\\"" @18:12-18:26
    next -> exit
  exit exit "exit" @18:26-18:26
"
`;

exports[`Python control flow > routes try, except, else, and finally 1`] = `
"attempt [python] cf:try
  entry entry "entry" @46:0-46:0
    next -> n0
  n0 try "try" @47:4-48:8
    next -> n1
    exception "except ValueError" -> n4
  n1 decision if "if value < 0" @48:8-49:12
    true "yes" -> n2
    false "no" -> n3
  n2 throw "raise ValueError(\\"no\\")" @49:12-49:34 calls ValueError("no")
    exception "except ValueError" -> n4
  n3 return "return value" @50:8-50:20
    finally -> n7
  n4 catch "except ValueError" @51:4-52:16
    next -> n5
  n5 return "return 0" @52:8-52:16
    finally -> n7
  n6 return unreachable "return 1" @54:8-54:16
  n7 finally "finally" @55:4-56:17
    next -> n8
  n8 statement "value = 0" @56:8-56:17
    next -> exit
  exit exit "exit" @56:17-56:17
"
`;

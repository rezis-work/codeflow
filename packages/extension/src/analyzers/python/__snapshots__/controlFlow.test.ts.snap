exports[`Python control flow > draws with, async with, yield, and async for 4`] = `
"async_items [python] cf:asyncfor
  entry entry "entry" @75:0-75:0
    next -> n0
  n0 statement "total = 0" @76:4-76:13
    next -> n1
  n1 loop for suspension "async for item in items" @77:4-78:8

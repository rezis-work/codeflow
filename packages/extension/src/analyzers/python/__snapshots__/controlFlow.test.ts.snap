// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Python control flow > branches if / elif / else 1`] = `
"branch [python] cf:branch
  entry entry "entry" @0:0-0:0
    next -> n0
  n0 decision if "if value > 0" @1:4-2:8
    true "yes" -> n1
    false "no" -> n2
  n1 return "return \\"pos\\"" @2:8-2:20
    next -> exit
  n2 decision if "elif value == 0" @3:4-4:8
    true "yes" -> n3
    false "no" -> n4
  n3 return "return \\"zero\\"" @4:8-4:21
    next -> exit
  n4 return "return \\"neg\\"" @6:8-6:20
    next -> exit
  exit exit "exit" @6:20-6:20
"
`;

exports[`Python control flow > collapses a nested function and a lambda 1`] = `
"nested [python] cf:nested
  entry entry "entry" @92:0-92:0
    next -> n0
  n0 statement "def inner(times):" @93:4-94:28 nested inner
    next -> n1
  n1 statement "scale = lambda factor: inner(factor)" @96:4-96:40 nested <lambda>
    next -> n2
  n2 return "return scale(2)" @97:4-97:19 calls scale(2)
    next -> exit
  exit exit "exit" @97:19-97:19
"
`;

exports[`Python control flow > dims code after return 1`] = `

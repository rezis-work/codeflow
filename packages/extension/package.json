{
  "name": "codeflow",
  "displayName": "CodeFlow",
  "description": "Interactive diagrams of how your code flows, shown beside the code.",
  "version": "0.1.0",
  "publisher": "codeflow",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rezis-work/codeflow.git"
  },
  "homepage": "https://github.com/rezis-work/codeflow",
  "bugs": {
    "url": "https://github.com/rezis-work/codeflow/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "diagram",
    "call-graph",
    "dependency-graph",
    "visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codeflow.openDiagram",
    "onCommand:codeflow.showFlowAtCursor",
    "onView:codeflow.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeflow.openDiagram",
        "title": "Open Diagram",
        "category": "CodeFlow",
        "icon": "$(open-preview)"
      },
      {
        "command": "codeflow.showFlowAtCursor",
        "title": "Show Flow for Symbol at Cursor",
        "category": "CodeFlow",
        "icon": "$(references)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeflow",
          "title": "CodeFlow",
          "icon": "media/codeflow.svg"
        }
      ]
    },
    "views": {
      "codeflow": [
        {
          "id": "codeflow.sidebar",
          "name": "Diagrams",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeflow.openDiagram",
          "when": "view == codeflow.sidebar",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codeflow.showFlowAtCursor",
          "when": "editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact || editorLangId == rust",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "CodeFlow",
      "properties": {
        "codeflow.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/dist/**",
            "**/out/**",
            "**/build/**",
            "**/coverage/**",
            "**/*.min.js",
            "**/.next/**"
          ],
          "description": "Glob patterns for files and folders CodeFlow does not analyze. node_modules is always skipped, and Rust analysis also skips target/. These patterns are combined with files.exclude."
        },
        "codeflow.maxFiles": {
          "type": "number",
          "default": 2500,
          "minimum": 1,
          "description": "Maximum number of files CodeFlow analyzes for each language in each workspace folder. TypeScript and Rust are capped separately."
        },
        "codeflow.view.defaultMode": {
          "type": "string",
          "enum": [
            "focus",
            "workspace"
          ],
          "default": "focus",
          "description": "Diagram opened by CodeFlow: Show Flow for Symbol at Cursor. focus draws the neighbourhood around the symbol (depth 2). workspace draws the whole graph and highlights the symbol. The toolbar toggle changes this for the open panel."
        },
        "codeflow.view.maxNodes": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "Maximum number of nodes the diagram draws at once. Larger graphs show a notice and suggest focus mode."
        },
        "codeflow.rust.useRustAnalyzer": {
          "type": "boolean",
          "default": true,
          "description": "When the rust-analyzer extension is installed and already running, use its call hierarchy to mark calls from the focused Rust symbol as certain. Tree-sitter still builds the graph when this is off or rust-analyzer is not active."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:integration": "tsc -p tsconfig.test.json && node ./out/runTest.js"
  },
  "devDependencies": {
    "@codeflow/shared": "*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "tree-sitter-rust": "^0.24.0",
    "vitest": "^5.1.0",
    "web-tree-sitter": "^0.24.7"
  }
}

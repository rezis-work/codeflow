{
  "name": "codeflow-site",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/check-links.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-links.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:overflow": "node scripts/check-overflow.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "playwright": "^1.65.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
